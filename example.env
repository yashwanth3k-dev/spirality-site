# Create a free PostgreSQL database: https://vercel.com/postgres
DB_PRISMA_URL=
DB_URL_NON_POOLING=

# Create github oauth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Site URL. Keep localhost for local dev.
# Production (Vercel): https://spiralitysolutions.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOADTHING_URL="http://localhost:3000"

# Bizdaptive CRM intake. Server-only — never prefix these with NEXT_PUBLIC_.
# Set both on the Vercel project before merging. Leave the key blank here.
CRM_INTAKE_URL=https://bizdaptive-crm.vercel.app/api/v1/intake/web-enquiry
CRM_INTAKE_KEY=

# Create a project in uploadthing and get api keys https://uploadthing.com/
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

#Stripe https://stripe.com/
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET =
STRIPE_PRO_PLAN_ID=
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=

# Google Stitch MCP — https://stitch.withgoogle.com → Profile → Stitch settings → API Keys
STITCH_API_KEY=
